# Optional: defaults work without an .env file. Relative paths resolve from backend/.
DATABASE_URL=sqlite:///./data/triprescue.db

# Keep false for local HTTP development. Enable with HTTPS before public hosting.
AUTH_COOKIE_SECURE=false

# JSON array of explicit frontend origins. No wildcard origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# The guided demo works without any paid API or key.
AI_MODE=ollama

# Free local inference. Run start-local-ai.ps1 after downloading the model.
# No API key, account, paid quota, or cloud inference is required for this mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
OLLAMA_CONTEXT_LENGTH=8192

# Optional live conversational replies: set AI_MODE=openai and configure your own
# key in backend/.env. Never put a provider key in frontend/ or source control.
# Conversation is sent to OpenAI only in openai mode; no backend chat history is saved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
